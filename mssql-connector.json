{
  "name": "mssql-connector",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "tasks.max": "1",

    "database.hostname": "host.docker.internal",
    "database.port": "1433",
    "database.user": "debezium_user",
    "database.password": "Dbz!123456",
    "database.names": "WalletSystemDB",
    "database.encrypt": "false",

    "database.server.name": "walletsystemdb",

    "table.include.list": "dbo.OutboxMessages",

    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-changes.mssql",

    "topic.prefix": "mssqlcdc",
    "snapshot.mode": "initial"

  }
}
